---
import MenuCategorias from '../components/MenuCategorias.astro';
import '../styles/global.css';
import { getProductosPorCategoria } from '../lib/productos';

const categoria = Astro.url.searchParams.get('categoria');
const idCategoria = Number(categoria);

const productos = await getProductosPorCategoria(idCategoria);

const nombresCategorias: Record<number, string> = {
  1: 'RUNNING',
  2: 'BASKETBALL',
  3: 'LIFESTYLE',
  4: 'RETRO',
  5: 'SKATE',
  6: 'HIGH TOP',
  7: 'LOW TOP'
};

const nombreCategoria = nombresCategorias[idCategoria] ?? 'SNEAKERS';
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>OFFSTEP — {nombreCategoria}</title>
  </head>

  <body class="m-0 bg-[#F9C3B6] text-[#102719]">

    <!-- ================= HEADER ================= -->

    <header class="bg-[#E30613] px-6 py-4">

      <div class="mx-auto flex max-w-7xl items-center justify-between gap-8">

        <!-- LOGO -->

        <a
          href="/"
          class="text-4xl font-black tracking-[-0.08em] text-white"
        >
          OFFSTEP
        </a>


        <!-- BUSCADOR -->

        <div class="hidden flex-1 max-w-2xl md:block">

          <div class="flex items-center bg-white px-5 py-3">

            <span class="mr-3 text-xl">
              ⌕
            </span>

            <span class="font-semibold text-gray-500">
              Buscar sneakers...
            </span>

          </div>

        </div>


        <!-- CUENTA / CARRITO -->

        <div class="flex items-center gap-5 font-black text-white">

          <a
            href="#"
            class="hidden md:block hover:underline"
          >
            ♙ CUENTA
          </a>

        <a href="/carrito" class="hover:underline">
  🛒 CARRITO
  <span id="contador-carrito" class="ml-1">0</span>
</a>

        </div>

      </div>

    </header>


    <!-- ================= MENÚ ================= -->

    <div class="border-b-2 border-black bg-[#102719] px-6 py-3">

      <div class="mx-auto max-w-7xl">

        <details class="relative">

          <summary
            class="flex cursor-pointer list-none items-center gap-3 text-lg font-black text-white"
          >

            <span class="text-3xl leading-none">
              ☰
            </span>

            <span>
              CATEGORÍAS
            </span>

          </summary>


          <div
            class="absolute left-0 top-full z-50 mt-3 w-72 border-2 border-black bg-[#F9C3B6] p-4 shadow-lg"
          >

            <MenuCategorias />

          </div>

        </details>

      </div>

    </div>


    <!-- ================= CONTENIDO ================= -->

    <main class="mx-auto max-w-7xl px-6 py-10">


      <!-- BREADCRUMB -->

      <nav class="mb-8 text-sm font-bold">

        <a
          href="/"
          class="underline decoration-2 underline-offset-4 hover:text-[#E30613]"
        >
          INICIO
        </a>

        <span class="mx-2 text-[#E30613]">
          /
        </span>

        <span>
          SNEAKERS
        </span>

        <span class="mx-2 text-[#E30613]">
          /
        </span>

        <span class="font-black">
          {nombreCategoria}
        </span>

      </nav>


      <!-- TÍTULO -->

      <section class="mb-10">

        <p
          class="text-sm font-black tracking-[0.3em] text-[#E30613]"
        >
          OFFSTEP · COLLECTION
        </p>

        <div class="mt-3 flex flex-col justify-between gap-4 md:flex-row md:items-end">

          <div>

            <h1
              class="text-5xl font-black uppercase leading-none tracking-[-0.05em] md:text-7xl"
            >
              {nombreCategoria}
            </h1>

            <p class="mt-4 text-lg font-bold">
              {productos.length} sneakers
            </p>

          </div>


          <!-- DECORACIÓN -->

          <div
            class="hidden border-2 border-[#102719] bg-[#E30613] px-5 py-3 text-sm font-black text-white md:block"
          >
            STEP DIFFERENT.
          </div>

        </div>

      </section>


      <!-- ================= ORDENAR / FILTRAR ================= -->

      <div
        class="mb-8 flex flex-wrap gap-3 border-y-2 border-[#102719] py-5"
      >

        <button
          type="button"
          class="border-2 border-[#102719] bg-white px-6 py-3 font-black transition hover:bg-[#102719] hover:text-white"
        >
          ☷ ORDENAR
        </button>

        <button
          type="button"
          class="border-2 border-[#102719] bg-white px-6 py-3 font-black transition hover:bg-[#102719] hover:text-white"
        >
          ⚙ FILTRAR
        </button>

        <div class="ml-auto hidden items-center font-bold md:flex">
          MOSTRANDO {productos.length} PRODUCTOS
        </div>

      </div>


      <!-- ================= GRID PRODUCTOS ================= -->

      <section
        class="grid grid-cols-1 gap-x-5 gap-y-12 sm:grid-cols-2 lg:grid-cols-3"
      >

        {productos.map((producto) => (

          <a
            href={`/productos/${producto.id_producto}`}
            class="group block"
          >

            <!-- IMAGEN -->

            <div
              class="relative aspect-square overflow-hidden border-2 border-transparent bg-white transition duration-300 group-hover:border-[#102719]"
            >

              <img
                src={
                  producto.id_producto <= 5
                    ? `https://zqfqsrcwdkvdcyggggzp.supabase.co/storage/v1/object/public/PRODUCTOS/${producto.id_producto}/runner-01.png`
                    : `https://zqfqsrcwdkvdcyggggzp.supabase.co/storage/v1/object/public/PRODUCTOS/${producto.id_producto}/01.png`
                }
                alt={producto.nombre}
                class="h-full w-full object-contain p-8 transition duration-500 group-hover:scale-105"
              />


              <!-- ETIQUETA -->

              <span
                class="absolute left-3 top-3 bg-[#E30613] px-3 py-2 text-xs font-black text-white"
              >
                OFFSTEP
              </span>


              <!-- FLECHA -->

              <span
                class="absolute bottom-3 right-3 flex h-10 w-10 items-center justify-center bg-[#102719] text-xl font-black text-white opacity-0 transition group-hover:opacity-100"
              >
                →
              </span>

            </div>


            <!-- INFORMACIÓN -->

            <div class="mt-4">

              <div class="flex items-start justify-between gap-4">

                <div>

                  <h2
                    class="text-xl font-black uppercase leading-tight"
                  >
                    {producto.nombre}
                  </h2>

                  <p
                    class="mt-1 text-sm font-bold text-[#102719]/60"
                  >
                    {producto.referencia}
                  </p>

                </div>


                <p class="whitespace-nowrap text-lg font-black">
                  {producto.precio} €
                </p>

              </div>


              <!-- STOCK -->

              <div class="mt-3 flex items-center gap-2 text-xs font-black uppercase">

                {producto.stock > 0 ? (
                  <>
                    <span class="h-2 w-2 rounded-full bg-[#102719]"></span>
                    Disponible
                  </>
                ) : (
                  <>
                    <span class="h-2 w-2 rounded-full bg-[#E30613]"></span>
                    Agotado
                  </>
                )}

              </div>


              <!-- CTA -->

              <div
                class="mt-4 border-b-2 border-[#102719] pb-2 text-sm font-black uppercase transition group-hover:border-[#E30613] group-hover:text-[#E30613]"
              >
                VER PRODUCTO →
              </div>

            </div>

          </a>

        ))}

      </section>


      <!-- ================= FINAL ================= -->

      <div class="mt-20 border-t-2 border-[#102719] pt-8">

        <div class="flex flex-col justify-between gap-4 md:flex-row">

          <p class="text-2xl font-black">
            DON'T FOLLOW.<br />
            <span class="text-[#E30613]">
              STEP DIFFERENT.
            </span>
          </p>

          <a
            href="/"
            class="inline-block self-start bg-[#E30613] px-7 py-4 text-sm font-black text-white transition hover:bg-[#102719]"
          >
            ← VOLVER A INICIO
          </a>

        </div>

      </div>

    </main>

    <script>
  function actualizarContadorCarrito() {
    const carritoGuardado = localStorage.getItem('carrito');

    const carrito = carritoGuardado
      ? JSON.parse(carritoGuardado)
      : [];

    const cantidad = carrito.reduce(
      (total: number, producto: { cantidad: number }) =>
        total + producto.cantidad,
      0
    );

    const contador =
      document.getElementById('contador-carrito');

    if (contador) {
      contador.textContent = String(cantidad);
    }
  }

  actualizarContadorCarrito();

  window.addEventListener(
    'carritoActualizado',
    actualizarContadorCarrito
  );
</script>

  </body>
</html>