
---
import '../styles/global.css';
import { supabase } from '../lib/supabase';
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>OFFSTEP — Crear cuenta</title>
  </head>

  <body class="m-0 bg-[#F9C3B6] text-[#102719]">
    <!-- HEADER -->
    <header class="bg-[#E30613] px-6 py-4">
      <div class="mx-auto flex max-w-7xl items-center justify-between gap-8">
        <a href="/" class="text-4xl font-black tracking-[-0.08em] text-white">
          OFFSTEP
        </a>

        <div class="flex items-center gap-5 font-black text-white">
          <a href="/cuenta" class="hover:underline">♙ CUENTA</a>

          <a href="/carrito" class="hover:underline">
            🛒 CARRITO
            <span id="contador-carrito" class="ml-1">0</span>
          </a>
        </div>
      </div>
    </header>

    <!-- REGISTRO -->
    <main class="mx-auto flex max-w-7xl justify-center px-6 py-16">
      <section class="w-full max-w-xl border-2 border-[#102719] bg-white p-8 md:p-12">
        <p class="text-sm font-black tracking-[0.3em] text-[#E30613]">
          OFFSTEP · ACCOUNT
        </p>

        <h1 class="mt-3 text-5xl font-black tracking-[-0.04em]">
          CREAR CUENTA
        </h1>

        <p class="mt-4 font-semibold">
          Regístrate para formar parte de OFFSTEP.
        </p>

        <form id="form-registro" class="mt-10">
          <div>
            <label for="nombre" class="block text-sm font-black uppercase">
              Nombre completo
            </label>
            <input
              id="nombre"
              name="nombre"
              type="text"
              placeholder="Tu nombre"
              autocomplete="name"
              required
              class="mt-2 w-full border-2 border-[#102719] px-4 py-4 outline-none focus:border-[#E30613]"
            />
          </div>

          <div class="mt-6">
            <label for="email" class="block text-sm font-black uppercase">
              Correo electrónico
            </label>
            <input
              id="email"
              name="email"
              type="email"
              placeholder="tu@email.com"
              autocomplete="email"
              required
              class="mt-2 w-full border-2 border-[#102719] px-4 py-4 outline-none focus:border-[#E30613]"
            />
          </div>

          <div class="mt-6">
            <label for="password" class="block text-sm font-black uppercase">
              Contraseña
            </label>
            <input
              id="password"
              name="password"
              type="password"
              placeholder="Mínimo 8 caracteres"
              autocomplete="new-password"
              minlength="8"
              required
              class="mt-2 w-full border-2 border-[#102719] px-4 py-4 outline-none focus:border-[#E30613]"
            />
          </div>

          <div class="mt-6">
            <label for="confirmar-password" class="block text-sm font-black uppercase">
              Confirmar contraseña
            </label>
            <input
              id="confirmar-password"
              name="confirmar-password"
              type="password"
              placeholder="Repite tu contraseña"
              autocomplete="new-password"
              minlength="8"
              required
              class="mt-2 w-full border-2 border-[#102719] px-4 py-4 outline-none focus:border-[#E30613]"
            />
          </div>

          <p id="mensaje-registro" class="mt-4 text-sm font-bold" aria-live="polite"></p>

          <button
            type="submit"
            class="mt-6 w-full bg-[#E30613] px-6 py-4 font-black text-white transition hover:bg-[#102719]"
          >
            CREAR CUENTA
          </button>
        </form>

        <div class="mt-8 border-t-2 border-[#102719] pt-6 text-center">
          <p class="font-semibold">¿Ya tienes una cuenta?</p>
          <a href="/cuenta" class="mt-2 inline-block font-black text-[#E30613] underline">
            INICIAR SESIÓN
          </a>
        </div>
      </section>
    </main>


<script>
  import { supabase } from '../lib/supabase';

  const formulario = document.getElementById('form-registro') as HTMLFormElement;
  const nombre = document.getElementById('nombre') as HTMLInputElement;
  const password = document.getElementById('password') as HTMLInputElement;
  const confirmarPassword = document.getElementById('confirmar-password') as HTMLInputElement;
  const mensaje = document.getElementById('mensaje-registro');
  const boton = formulario.querySelector('button[type="submit"]') as HTMLButtonElement;

  formulario.addEventListener('submit', async (evento) => {
    evento.preventDefault();

    if (password.value !== confirmarPassword.value) {
      if (mensaje) {
        mensaje.textContent = 'Las contraseñas no coinciden.';
        mensaje.className = 'mt-4 text-sm font-bold text-[#E30613]';
      }
      return;
    }

    boton.disabled = true;
    boton.textContent = 'CREANDO CUENTA...';

    const { data, error } = await supabase.auth.signUp({
      email: (document.getElementById('email') as HTMLInputElement).value.trim(),
      password: password.value,
      options: {
        data: {
          nombre: nombre.value.trim(),
        },
      },
    });

    if (error) {
      if (mensaje) {
        mensaje.textContent = 'No se pudo crear la cuenta: ' + error.message;
        mensaje.className = 'mt-4 text-sm font-bold text-[#E30613]';
      }
      boton.disabled = false;
      boton.textContent = 'CREAR CUENTA';
      return;
    }

    if (mensaje) {
      mensaje.className = 'mt-4 text-sm font-bold text-[#102719]';
      mensaje.textContent = data.session
        ? '¡Cuenta creada correctamente! Ya puedes iniciar sesión.'
        : '¡Registro realizado! Revisa tu correo para confirmar la cuenta.';
    }

    formulario.reset();
    boton.disabled = false;
    boton.textContent = 'CREAR CUENTA';
  });
</script>

  </body>
</html>
